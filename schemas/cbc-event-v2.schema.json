{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-butler.local/schemas/cbc-event-v2.schema.json",
  "title": "cbc-event/v2",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "timestamp",
    "source",
    "identity",
    "event_type",
    "chain_id",
    "level",
    "action",
    "detail",
    "evidence_hash",
    "prev_hash",
    "event_hash",
    "seq"
  ],
  "properties": {
    "schema": {"const": "cbc-event/v2"},
    "event_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["kind", "name", "version", "instance"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "instance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "required": ["package_id", "producer_id", "package_version"],
      "properties": {
        "package_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "producer_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": true
    },
    "event_type": {
      "enum": ["observation", "decision", "gate", "release", "error"]
    },
    "chain_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "level": {"enum": ["INFO", "WARN", "CRITICAL"]},
    "action": {"type": "string", "minLength": 1},
    "detail": {"type": "object"},
    "evidence_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prev_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "seq": {"type": "integer", "minimum": 1},
    "trace_id": {"type": "string"},
    "host": {"type": "string"}
  },
  "additionalProperties": true
}
