{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-butler.local/schemas/cbc/semantic-verdict-v1.schema.json",
  "title": "CBC semantic-verdict/v1 reader schema",
  "type": "object",
  "required": ["schema", "verdict", "subject", "generated_at", "evidence_sha256"],
  "properties": {
    "schema": {"const": "semantic-verdict/v1"},
    "verdict": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "subject": {
      "type": "object",
      "required": ["package_id", "artifact_sha256"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "generated_at": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object"}},
    "policy": {"type": "object"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  },
  "additionalProperties": true
}
